# Copy this file to .env and fill in real values. .env is git-ignored.

# If unset, the server auto-starts an in-memory MongoDB for local dev.
MONGODB_URI=

PORT=4000
JWT_SECRET=dev-secret-change-me

# Fixed OTP accepted for every phone number in dev (mocked SMS provider).
DEV_OTP=000000

CLIENT_ORIGIN=http://localhost:5173

# Indian Kanoon API token (https://api.indiankanoon.org) — powers case law search
# and the AI Legal Assistant. Costs money per call.
IK_API_TOKEN=

# OpenRouter API key (https://openrouter.ai) — powers LLM calls (query understanding
# and grounded answer generation).
OPENROUTER_API_KEY=

# OpenRouter model slug. Free-tier slugs get retired over time — if calls start
# 404ing, check https://openrouter.ai/models for a current `:free` alternative.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Google Gemini API key (https://aistudio.google.com/apikey — free, no credit card) —
# OPTIONAL. Powers semantic embedding re-ranking of Indian Kanoon search results in the
# AI Legal Assistant (server/src/services/relevanceRanking.js). If unset, the app
# automatically falls back to a local TF-IDF ranker (no cost, no API call) — this is a
# quality enhancement, never a hard requirement.
GEMINI_API_KEY=

# Gemini embedding model slug. Only matters if GEMINI_API_KEY is set above.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
