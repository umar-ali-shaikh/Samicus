# Single shared file for both apps: copy to .env at the repo root (not inside backend/ or
# frontend/) and fill in real values. .env is git-ignored. Backend reads it via
# backend/src/config/env.js; the frontend's Vite config points envDir at this same root.

# ─── Supabase (Postgres + Auth + Storage) ─────────────────────────────────────────────────
# Project Settings → API. Free tier is enough to launch.
SUPABASE_URL=
# service_role key — bypasses RLS, used only by this API server.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for uploaded documents (created automatically on boot if missing).
SUPABASE_DOCUMENT_BUCKET=documents

# ─── Google OAuth (Supabase Auth → Providers → Google) ────────────────────────────────────
# Not read by app code — Supabase calls Google directly. Kept here only as a record of what
# was pasted into the Supabase dashboard, so the values aren't lost.
# Google Cloud Console → Credentials → OAuth client. Redirect URI must be
# https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────────────────
PORT=4000
# Browser origin(s) allowed to call the API, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# Emails that get elevated roles on their first VERIFIED sign-in (comma-separated).
# Roles are never assignable from the client.
ADMIN_EMAILS=
FOUNDER_EMAILS=

# ─── Qdrant (vector search for the RAG knowledge base) ────────────────────────────────────
# Qdrant Cloud free tier (1 GB, no card): https://cloud.qdrant.io — or a self-hosted container.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=vidhira_legal
QDRANT_CLAUSE_COLLECTION=vidhira_clauses

# Passages scoring at least RAG_MIN_SCORE are used as evidence. If at least
# RAG_SKIP_LIVE_MIN_PASSAGES passages score >= RAG_SKIP_LIVE_SEARCH_SCORE the paid live
# Indian Kanoon search is skipped entirely (the knowledge base answers on its own).
# These cosine scores are not calibrated for legal text — tune with real traffic.
RAG_MIN_SCORE=0.55
RAG_SKIP_LIVE_SEARCH_SCORE=0.72
RAG_SKIP_LIVE_MIN_PASSAGES=3

# ─── Embeddings (required for RAG) ────────────────────────────────────────────────────────
# Embeddings go through OpenRouter (OPENROUTER_API_KEY below) — no separate key needed.
# all-mpnet-base-v2 is 768-dim, matching rag/qdrant.js's VECTOR_SIZE exactly. Changing this
# to a model with a different native dimension requires recreating the Qdrant collection(s)
# and running `npm run rag:reembed-all` — see docs/RAG.md.
OPENROUTER_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ─── Legal sources + LLM ──────────────────────────────────────────────────────────────────
# Indian Kanoon API token (https://api.indiankanoon.org) — costs money per call. Check their
# terms before relying on the persistent index the RAG pipeline builds from their documents.
IK_API_TOKEN=
# OpenRouter (https://openrouter.ai) — query understanding, grounded answers, contract
# review, AND embeddings (see OPENROUTER_EMBEDDING_MODEL above). Needs real credit on the
# account — paid models only (see services/openRouter.js's DEFAULT_MODEL/FALLBACK_MODELS).
OPENROUTER_API_KEY=
# Paid-tier slugs occasionally get renamed/retired too — if calls start 404ing, pick a
# current model that supports structured_outputs (see services/openRouter.js) — the
# assistant's prompt is long/multi-constraint and a weaker model tends to under-fill
# response arrays even when the evidence supports more.
OPENROUTER_MODEL=openai/gpt-oss-20b
# Optional. When the AI Legal Assistant's generation call comes back truncated/unparseable
# or with every array field empty despite real evidence (a known failure mode for
# non-Latin-script output on a cheap/free model), it retries once on OPENROUTER_MODEL, then
# once more pinned to this model, before giving up. Leave blank to skip that second retry —
# the first retry on OPENROUTER_MODEL still happens either way. Pick a model that supports
# response_format/structured_outputs, same constraint as OPENROUTER_MODEL above.
OPENROUTER_FALLBACK_MODEL=

# ─── Web search fallback (optional) ────────────────────────────────────────────────────────
# Tavily (https://tavily.com — free tier available) — Stage 4 of the legal assistant pipeline,
# only called when the knowledge base AND Indian Kanoon are both thin. Restricted to a trusted
# government/legal-aid domain allowlist (see services/tavily.js). Leave blank to skip this stage
# entirely — the assistant still works from the knowledge base + Indian Kanoon alone.
TAVILY_API_KEY=

# ─── Payments (optional) ──────────────────────────────────────────────────────────────────
# Razorpay (https://razorpay.com): pay-per-transaction, no monthly fee. Leave blank to run
# without online payments — the UI then says so instead of faking a checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://<your-app>/api/payments/webhook, event: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# ─── Video (optional) ─────────────────────────────────────────────────────────────────────
# Consultation rooms use Jitsi Meet. Point at a self-hosted instance if you run one.
VIDEO_BASE_URL=https://meet.jit.si

# ─── Frontend (Vite) ───────────────────────────────────────────────────────────────────────
# Baked into the browser bundle at build time — only PUBLIC values belong here.
# Supabase project URL + anon (public) key: Project Settings → API.
# The anon key is safe in the browser because the database denies it everything (see
# backend/src/db/schema.sql, "security" section); all data goes through the API server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development proxies /api to the backend; change the target here if it isn't on :4000.
# VITE_DEV_API_TARGET=http://localhost:4000
# Only for a split deployment (frontend hosted apart from the API); default is same-origin /api.
# VITE_API_BASE_URL=
