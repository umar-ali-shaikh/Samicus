{
  "name": "vidhira",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "frontend",
    "apps/api",
    "apps/web",
    "apps/worker",
    "packages/contracts",
    "packages/config"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:full": "concurrently -n SERVER,CLIENT -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w frontend\"",
    "seed": "npm run seed -w apps/api",
    "build": "npm run build -w frontend",
    "start": "npm run start -w apps/api",
    "test": "npm test -w apps/api",
    "lint": "npm run lint -w frontend",
    "e2e": "npm run e2e -w frontend",
    "qa-smoke": "node scripts/qa-smoke.js",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
