{
  "name": "@vidhira/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RAG ingest/reindex/reprocess/reembed and other long-running jobs, split out of apps/api per docs/MASTER-PROMPT.md Phase 4 -- processes pg-boss jobs via src/index.ts; src/cli.ts enqueues them (replacing apps/api's old rag:* scripts).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --env-file-if-exists=../../.env --test --experimental-test-module-mocks",
    "rag:reindex": "tsx --env-file-if-exists=../../.env src/cli.ts reindex",
    "rag:reembed-all": "tsx --env-file-if-exists=../../.env src/cli.ts reembed-all",
    "rag:reprocess": "tsx --env-file-if-exists=../../.env src/cli.ts reprocess",
    "rag:status": "tsx --env-file-if-exists=../../.env src/cli.ts status"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@vidhira/rag": "*",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vidhira/config": "*",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
