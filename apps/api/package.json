{
  "name": "@vidhira/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.js",
    "start": "tsx --env-file-if-exists=../../.env src/index.js",
    "seed": "node --env-file-if-exists=../../.env src/seed/seed.js",
    "seed:research-examples": "node --env-file-if-exists=../../.env src/seed/researchExamples.js",
    "seed:demo-advocates": "node --env-file-if-exists=../../.env src/seed/demoAdvocates.js",
    "test": "tsx --env-file-if-exists=../../.env --test --experimental-test-module-mocks",
    "typecheck": "tsc --noEmit",
    "research:check": "node --env-file-if-exists=../../.env src/scripts/researchRetrievalCheck.js",
    "audit:routes": "node scripts/auditRoutes.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@vidhira/contracts": "*",
    "@vidhira/rag": "*",
    "cors": "^2.8.5",
    "docx": "^9.8.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "sanitize-html": "^2.13.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "description": "Vidhira API — Express + Supabase (Postgres, Auth, Storage) + Qdrant"
}
