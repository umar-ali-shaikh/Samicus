{
  "name": "@vidhira/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.js",
    "start": "tsx src/index.js",
    "seed": "node src/seed/seed.js",
    "seed:research-examples": "node src/seed/researchExamples.js",
    "seed:demo-advocates": "node src/seed/demoAdvocates.js",
    "test": "tsx --test --experimental-test-module-mocks",
    "typecheck": "tsc --noEmit",
    "rag:reindex": "node src/utils/rag.js reindex",
    "rag:reembed-all": "node src/utils/rag.js reembed-all",
    "rag:reprocess": "node src/utils/rag.js reprocess",
    "rag:status": "node src/utils/rag.js status",
    "research:check": "node src/scripts/researchRetrievalCheck.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@vidhira/contracts": "*",
    "cors": "^2.8.5",
    "docx": "^9.8.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "sanitize-html": "^2.13.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "description": "Vidhira API — Express + Supabase (Postgres, Auth, Storage) + Qdrant"
}
